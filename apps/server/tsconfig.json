{
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./dist",

		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"target": "ESNext",

		"types": ["node"],

		"strict": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,

		"sourceMap": true,

		"declaration": false,
		"declarationMap": false,

		"skipLibCheck": true
	},

	"include": ["src"]
}
